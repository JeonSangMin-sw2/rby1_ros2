<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rby1_moveit_objects</name>
  <version>0.0.0</version>
  <description>MoveIt planning-scene objects for any RB-Y1 model: add, move, remove and load obstacles (scene), put modules (grippers, sensors, tools) on robot links or fixtures in the world from a YAML file with mesh files or primitive shapes (publish_objects), and put one obstacle where a point topic says (object_at_point)</description>
  <maintainer email="sangmin.jeon@rainbow-robotics.com">jsm</maintainer>
  <license>TODO: License declaration</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>moveit_msgs</depend>
  <depend>shape_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>geometric_shapes</depend>
  <depend>yaml-cpp</depend>
  <depend>eigen</depend>
  <depend>ament_index_cpp</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
